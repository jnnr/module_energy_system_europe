rule all:
    message:
        "ERROR: Invalid `rule all:` call"
    default_target: True
    output:
        "INVALID",
    log:
        stderr="<logs>/all.stderr",
    conda:
        "envs/module.yaml"
    shell:
        'echo "This workflow must be called as a snakemake module." > {log.stderr}'


SHAPES = "EUROPE_S_C1_ADM1"
rule test_integration:
    default_target: True
    input:
        expand(
            "results/module_area_potentials/results/{shape}/reference/area_potential_{tech}.tif",
            tech=["wind_onshore", "wind_offshore", "pv_open_field", "pv_rooftop"],
            shape=SHAPES,
        ),
        expand(
            "results/module_demand_electricity/results/{shapes}/demand_electricity_MW.parquet",
            shapes=SHAPES,
        ),
        expand("results/module_euro_building_heat/results/{shapes}/annual/heat_demand_twh.parquet", shapes=SHAPES),
        expand("results/module_euro_building_heat/results/{shapes}/hourly/heat_demand_mwh.parquet", shapes=SHAPES),
        expand("results/module_euro_building_heat/results/{shapes}/hourly/heat_pump_cop_pu.parquet", shapes=SHAPES),
        expand("results/module_euro_building_heat/results/{shapes}/hourly/heat_pump_electricity_demand_mwh.parquet", shapes=SHAPES),
        "results/module_geo_boundaries/results/NUTS0/shapes.parquet",
        expand("results/module_hydropower/results/{shapes}/statistics/generation.parquet", shapes=SHAPES),
        expand("results/module_hydropower/results/{shapes}/disaggregated/inflow_mwh.parquet", shapes=SHAPES),
        expand("results/module_hydropower/results/{shapes}/aggregated/{plant_type}_inflow_pu.parquet", shapes=SHAPES, plant_type=["run_of_river", "reservoir"]),
        expand(
            "results/module_powerplants/results/{shapes}/aggregated/{adjustment}/{category}.parquet",
            shapes=SHAPES,
            adjustment=["adjusted"],
            category=["bioenergy", "fossil", "geothermal", "hydropower", "nuclear", "wind", "solar"]  # "large_solar"
        )
