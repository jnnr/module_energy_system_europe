# Emulate a user configuring the module.
configfile: workflow.source_path("./test_config.yaml")

# Emulate how another workflow might create inputs for this module.
rule create_external_input:
    message: "Example of a rule external to your module."
    output:
        text_file = "resources/user/user_message.md"
    run:
        from pathlib import Path
        from textwrap import dedent
        text = dedent("""Modular workflows can be used by more than one project!
            For example, this text comes from a file external to the module.
            Try your best to make this workflow reusable so that others may benefit from your methods."""
        )
        file_path = Path(output.text_file)
        with file_path.open("w") as f:
            f.write(text)

# Import the module and configure it.
# `snakefile:` specifies the module. It can use file paths and special github(...) / gitlab(...) markers
# `config`: specifies the module configuration.
# `pathvars:` helps you re-wire where the module places files.
module module_energy_system_europe:
    snakefile: "../../workflow/Snakefile"
    config: config["module_energy_system_europe"]
    pathvars:
        # Redirect specific user resources (inputs)
        user_message=rules.create_external_input.output.text_file,
        # Redirect specific module results (outputs)
        combined_text="results/output/combined_text.md",
        # Redirect intermediate files that are internal to the module
        logs="resources/module/logs",
        resources="resources/module/resources",
        results="resources/module/results"


# rename all module rules with a prefix, to avoid naming conflicts.
use rule * from module_energy_system_europe as module_energy_system_europe_*

# Request something from the module
SHAPES = "EUROPE_S_C1_ADM1"
rule all:
    default_target: True
    input:
        expand(
            "results/module_area_potentials/results/{shape}/reference/area_potential_{tech}.tif",
            tech=["wind_onshore", "wind_offshore", "pv_open_field", "pv_rooftop"],
            shape=SHAPES,
        ),
        expand(
            "results/module_demand_electricity/results/{shapes}/demand_electricity_MW.parquet",
            shapes=SHAPES,
        ),
        expand("results/module_euro_building_heat/results/{shapes}/annual/heat_demand_twh.parquet", shapes=SHAPES),
        expand("results/module_euro_building_heat/results/{shapes}/hourly/heat_demand_mwh.parquet", shapes=SHAPES),
        expand("results/module_euro_building_heat/results/{shapes}/hourly/heat_pump_cop_pu.parquet", shapes=SHAPES),
        expand("results/module_euro_building_heat/results/{shapes}/hourly/heat_pump_electricity_demand_mwh.parquet", shapes=SHAPES),
        "results/module_geo_boundaries/results/NUTS0/shapes.parquet",
        expand("results/module_hydropower/results/{shapes}/statistics/generation.parquet", shapes=SHAPES),
        expand("results/module_hydropower/results/{shapes}/disaggregated/inflow_mwh.parquet", shapes=SHAPES),
        expand("results/module_hydropower/results/{shapes}/aggregated/{plant_type}_inflow_pu.parquet", shapes=SHAPES, plant_type=["run_of_river", "reservoir"]),
        expand(
            "results/module_powerplants/results/{shapes}/aggregated/{adjustment}/{category}.parquet",
            shapes=SHAPES,
            adjustment=["adjusted"],
            category=["bioenergy", "fossil", "geothermal", "hydropower", "nuclear", "wind", "solar"]  # "large_solar"
        )
